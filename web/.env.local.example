# Arc Testnet deployment (mock USDC stack).
# Copy to .env.local. Everything here is public on-chain data, so NEXT_PUBLIC_ is fine.
# Never put a private key in this file — the frontend signs with the user's wallet.

NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io

NEXT_PUBLIC_INSURANCE_ADDRESS=0x5F10f4694055d64DBe8B4C5E2E03BE7A0986E8eb
NEXT_PUBLIC_VAULT_ADDRESS=0x27FAF75ef7378240fD8963662c6f3d3EBE5f013c
NEXT_PUBLIC_FLIGHT_REGISTRY_ADDRESS=0x0C6572C440cA1d1eba938640326358FAE08992Ae
NEXT_PUBLIC_FLIGHT_AGENT_ADDRESS=0x5000D5Ee64Ba44F76047Fc60e0ef5Df1d3203CAC

NEXT_PUBLIC_USDC_ADDRESS=0xc00E27A30f5b644342a5C0556024892305fC730b

# The asset is MockUSDC with an open mint, so the app can offer a faucet button.
# Set to false when pointing at a deployment that uses Arc's real USDC.
NEXT_PUBLIC_ASSET_IS_MINTABLE=true
