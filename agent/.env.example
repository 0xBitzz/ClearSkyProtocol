# RPC + chain
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# The agent's on-chain signer. MUST be bound to an ERC-8004 identity via
# FlightAgent.registerAgent(operator, agentId). AGENT_ROLE on its own is not
# enough where an IdentityRegistry is configured — reports revert with
# AgentIdentityRequired. See `npm run register-identity` to mint the identity.
AGENT_PRIVATE_KEY=0x...

# Deployment addresses
FLIGHT_AGENT_ADDRESS=0x5000D5Ee64Ba44F76047Fc60e0ef5Df1d3203CAC


FLIGHT_REGISTRY_ADDRESS=0x0C6572C440cA1d1eba938640326358FAE08992Ae
INSURANCE_ADDRESS=0x5F10f4694055d64DBe8B4C5E2E03BE7A0986E8eb

# ERC-8004 IdentityRegistry. Optional — defaults to the canonical Arc Testnet
# deployment below, which is what FlightAgent was constructed with. Used by
# `npm run register-identity` to mint the agent's identity NFT.
# IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# Metadata URI stored against the identity. Upload agent/agent-metadata.json to
# IPFS and point this at it; falls back to Arc's example CID if unset.
# METADATA_URI=ipfs://...


# Flight data source.
#
# Default is the free Next mock. Switch to StableTravel for real FlightAware
# data — it is x402-priced, so there is no API key: each call pays $0.01 USDC
# from the Circle Agent Wallet below, and the payment IS the auth.
#
#   FLIGHTAWARE_BASE_URL=https://stabletravel.dev/api/flightaware
#
# Paid mode turns on automatically for any non-localhost base URL.
FLIGHTAWARE_BASE_URL=http://localhost:3000/api/flightaware

# --- Circle Agent Wallet (pays for flight data) ------------------------------
# Only needed when FLIGHTAWARE_BASE_URL points at a paid provider.
#
# This is NOT the same wallet as AGENT_PRIVATE_KEY. It spends real USDC on Base
# mainnet to buy data; the Arc key writes results on-chain. Its private key stays
# inside the Circle CLI and is never read by this process, so there is nothing
# here to leak.
#
#   circle wallet list --chain BASE --type agent
#
# CIRCLE_WALLET_ADDRESS=0x...
# CIRCLE_PAY_CHAIN=BASE

# Per-call spend ceiling in USDC. The CLI refuses to pay above it, so a price
# change at the seller cannot quietly drain the wallet. StableTravel is $0.01.
# X402_MAX_AMOUNT_USDC=0.02

# What to monitor. Accepts flight numbers or FlightAware leg ids.
#
# Prefer leg ids in production. A flight number is ambiguous — UAL455 is two
# different routes on the same day (KPIT->KORD at 14:54Z, KORD->KPHX at 18:30Z)
# — so the agent has to infer which leg the traveller bought. A leg id resolves
# to exactly one flight and one query:
#
#   MONITORED_FLIGHTS=UAL455-1785974592-fa-1986p
#
# Flight numbers still work; selectCurrentLeg picks the operative leg.
MONITORED_FLIGHTS=CS1001,CS1002,CS1003,CS1004,CS1005


# Poll interval in seconds
POLL_INTERVAL_SECONDS=30
